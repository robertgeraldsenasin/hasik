{
  // Use the repo's TypeScript (same version as CI), not VS Code's bundled one.
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.preferences.importModuleSpecifier": "non-relative",

  // Format on save with Prettier; fix lint issues on save with ESLint (flat config).
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": { "source.fixAll.eslint": "explicit" },
  "eslint.useFlatConfig": true,
  "eslint.workingDirectories": [{ "mode": "auto" }],

  "files.exclude": { "**/.turbo": true, "**/coverage": true, "**/dist": true },
  "search.exclude": { "**/node_modules": true, "pnpm-lock.yaml": true, "results/*.jsonl": true },
  "files.eol": "\n",
  "cSpell.words": [
    "Sungka",
    "Hasik",
    "sigay",
    "kabibe",
    "perft",
    "Zobrist",
    "negamax",
    "Glicko",
    "SPRT",
    "pentanomial",
    "trinomial",
    "playouts",
    "Turborepo",
    "Baguhan",
    "Sakim",
    "Matalino",
    "Dalubhasa"
  ]
}
