{
  "name": "@hasik/web",
  "version": "0.1.0",
  "private": true,
  "description": "Play Sungka in the browser against Hasik's bots.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hasik/bots": "workspace:*",
    "@hasik/engine": "workspace:*",
    "@hasik/protocol": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "vite": "^8.3.8"
  }
}
